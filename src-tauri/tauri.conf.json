{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TunnelForge",
  "version": "0.1.0",
  "identifier": "com.tunnelforge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TunnelForge",
        "width": 900,
        "height": 680,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://*; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "TunnelForge - Tunnel Manager"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": [],
    "copyright": "© 2026 TunnelForge",
    "category": "Network",
    "shortDescription": "Expose local services to the internet without a VPS",
    "longDescription": "TunnelForge is a cross-platform desktop application that makes it easy to expose local network services to the internet. No VPS, no port forwarding, no CLI required."
  },
  "plugins": {}
}
